---
import BaseLayout from "../layouts/BaseLayout.astro";

const contacts = [
  { label: "giolynx104@gmail.com", href: "mailto:giolynx104@gmail.com" },
  { label: "GitHub", href: "https://github.com/alexajuno" },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/giao-le-02606b323",
  },
];

const experience = [
  {
    role: "Software Developer",
    company: "Qikify",
    period: "Jun 2025 – Present",
    products: [
      {
        name: "Imagenhub",
        tagline: "AI image-generation platform for print-on-demand",
        bullets: [
          "<strong>Backend engineer:</strong> own the server side of a launched image-generation platform unifying 13 providers and 58 models (fal, Replicate, OpenAI) behind one API, serving ~90K generations a month into the Teeinblue print-on-demand ecosystem.",
          "<strong>Built the provider orchestration layer:</strong> routes each generation across providers and fails over automatically on route-level faults or an out-of-funds account, holding a 99.4% success rate (565 failures in ~90K) by classifying provider faults and rotating credentials.",
          "<strong>Built the async generation pipeline</strong> for model latencies far beyond a normal request cycle: queued workers, signature-verified provider webhooks backed by a reconciliation watchdog and polling fallback for missing callbacks, and results streamed to the client over SSE.",
          "<strong>Own the Polar billing system and its ~90K-transaction credit ledger:</strong> calibrate credit costs to each provider's price (the margin model), run a transactional outbox for reliable event delivery, and resolve subscribers idempotently, closing undercharge and double-charge gaps across the async boundary.",
          "<strong>Built authentication, API keys, and multi-tenancy:</strong> architected the platform's organization-scoped tenant model (org context, membership, invitations) with tenant isolation native to the data schema.",
        ],
      },
      {
        name: "Bridz",
        tagline: "multi-tenant customer-feedback platform",
        bullets: [
          "<strong>Designed, built, and shipped Bridz:</strong> a multi-tenant Laravel + Vue feedback platform replacing Canny across Qikify and Teeinblue (~3,000+ engaged users).",
          "<strong>Built the differentiating features:</strong> a vote-velocity trending algorithm, per-workspace branding on custom subdomains, and an embeddable widget SDK (server-rendered, themeable, with deep-linked notifications) that mounts the feedback board inside customers' own sites.",
        ],
      },
      {
        name: "Teeinblue",
        tagline: "personalized print-on-demand product",
        bullets: [
          "<strong>Built a centralized search service:</strong> Typesense-backed, indexing ~2–3M entities, owning the indexing pipeline and query/filter design.",
          "<strong>Built a generic soft-delete/restore layer</strong> across nearly all customer-facing models, eliminating accidental-deletion data loss.",
          "<strong>Implemented rate limiting on AI image generation endpoints:</strong> encrypted-header anonymous identity to harden anti-abuse on Shopify-facing routes.",
        ],
      },
    ],
  },
];

const projects = [
  {
    title: "Phileas",
    tagline: "Open-source local-first long-term memory for LLM agents",
    meta: "Python · MCP · MIT",
    href: "https://github.com/alexajuno/phileas",
    bullets: [
      "Local-first memory layer that any LLM reads and writes over <strong>MCP</strong>, so context survives across sessions and tools instead of resetting each conversation.",
      "Model-agnostic hybrid retrieval over BM25, semantic vectors, and knowledge-graph search, re-ranked with a local cross-encoder; runs on-device with no external API key.",
      "Designed and shipped <strong>solo, end-to-end</strong>: retrieval engine, MCP server, ingestion pipeline, and CLI, published to PyPI under MIT.",
      "Used daily as my own working memory.",
    ],
  },
];

---

<BaseLayout title="CV — alexajuno" description="Giao Le Xuan — Software Engineer. Experience, projects, and education.">
  <!-- Header -->
  <section class="border-b border-zinc-200 pb-8 pt-8 dark:border-zinc-800 sm:pb-10 sm:pt-12">
    <h1 class="animate-fade-in-up text-4xl font-bold tracking-tight sm:text-5xl">
      Giao Le Xuan
    </h1>
    <p class="animate-fade-in-up delay-100 mt-3 text-lg text-zinc-600 dark:text-zinc-400">
      Software Engineer · Hanoi, Vietnam
    </p>

    <div class="animate-fade-in-up delay-200 mt-5 flex flex-wrap items-center gap-2 text-sm text-zinc-500 dark:text-zinc-500">
      {
        contacts.map((c, i) => (
          <>
            {i > 0 && <span aria-hidden="true">·</span>}
            <a
              href={c.href}
              target={c.href.startsWith("http") ? "_blank" : undefined}
              rel={c.href.startsWith("http") ? "noopener noreferrer" : undefined}
              class="transition-colors hover:text-zinc-900 dark:hover:text-zinc-100"
            >
              {c.label}
            </a>
          </>
        ))
      }
    </div>
  </section>

  <!-- Summary -->
  <section class="animate-fade-in-up border-b border-zinc-200 py-8 dark:border-zinc-800">
    <p class="max-w-2xl text-base leading-relaxed text-zinc-700 dark:text-zinc-300">
    product engineer, focusing on backend and infra. familiar with handling vague requests and turning that into working features with security and reliablity in mind. 
    </p>
  </section>

  <section class="border-b border-zinc-200 py-8 dark:border-zinc-800">
    <h2 class="animate-fade-in-up text-xs font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
      Experience
    </h2>
    <div class="mt-6 space-y-8">
      {
        experience.map((job) => (
          <div class="animate-fade-in-up">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">
                {job.role} · {job.company}
              </h3>
              <span class="shrink-0 text-sm tabular-nums text-zinc-500 dark:text-zinc-500">
                {job.period}
              </span>
            </div>
            <div class="mt-4 space-y-5">
              {job.products.map((product) => (
                <div>
                  <h4 class="text-sm font-semibold text-zinc-800 dark:text-zinc-200">
                    {product.name}
                    <span class="font-normal text-zinc-500 dark:text-zinc-500">
                      {" · "}
                      {product.tagline}
                    </span>
                  </h4>
                  <ul class="mt-2 space-y-2">
                    {product.bullets.map((b) => (
                      <li class="flex gap-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                        <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-zinc-400 dark:bg-zinc-600" />
                        <span set:html={b} />
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Projects -->
  <section class="border-b border-zinc-200 py-8 dark:border-zinc-800">
    <h2 class="animate-fade-in-up text-xs font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
      Projects
    </h2>
    <div class="mt-6 space-y-8">
      {
        projects.map((p) => (
          <div class="animate-fade-in-up">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">
                {p.href ? (
                  <a
                    href={p.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="transition-colors hover:text-accent-600 dark:hover:text-accent-400"
                  >
                    {p.title}
                  </a>
                ) : (
                  p.title
                )}
              </h3>
              <span class="shrink-0 text-sm text-zinc-500 dark:text-zinc-500">
                {p.meta}
              </span>
            </div>
            <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
              {p.tagline}
            </p>
            <ul class="mt-3 space-y-2">
              {p.bullets.map((b) => (
                <li class="flex gap-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-zinc-400 dark:bg-zinc-600" />
                  <span set:html={b} />
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Education -->
  <section class="py-8">
    <h2 class="animate-fade-in-up text-xs font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
      Education
    </h2>
    <div class="animate-fade-in-up mt-6 flex flex-wrap items-baseline justify-between gap-3">
      <div>
        <h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">
          Bachelor of Computer Science
        </h3>
        <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
          Hanoi University of Science and Technology
        </p>
      </div>
      <span class="shrink-0 text-sm tabular-nums text-zinc-500 dark:text-zinc-500">
        Oct 2021 – Sep 2025
      </span>
    </div>
  </section>
</BaseLayout>
