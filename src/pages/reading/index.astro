---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const links = (await getCollection("reading")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

function hostname(url: string) {
  return new URL(url).hostname.replace(/^www\./, "");
}

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout title="Reading — alexajuno" description="Links I've found interesting.">
  <section class="pb-8 pt-8 sm:pb-10 sm:pt-12">
    <h1 class="animate-fade-in-up text-4xl font-bold tracking-tight sm:text-5xl">Reading</h1>
    <p class="animate-fade-in-up delay-100 mt-4 max-w-lg text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
      Links I've found interesting.
    </p>
  </section>

  <ul class="space-y-6">
    {
      links.map((link) => (
        <li class="animate-fade-in-up card-hover group rounded-xl border border-zinc-200 p-6 transition-colors hover:border-zinc-300 dark:border-zinc-800 dark:hover:border-zinc-700">
          <a
            href={link.data.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-start justify-between gap-4"
          >
            <h2 class="text-lg font-semibold text-zinc-900 transition-colors group-hover:text-accent-600 dark:text-zinc-100 dark:group-hover:text-accent-400">
              {link.data.title}
            </h2>
            <svg
              class="mt-1 h-4 w-4 shrink-0 text-zinc-400 transition-colors group-hover:text-accent-600 dark:group-hover:text-accent-400"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
              />
            </svg>
          </a>
          <div class="mt-1 flex items-center gap-2 text-sm text-zinc-500 dark:text-zinc-500">
            <span>{hostname(link.data.url)}</span>
            <span>·</span>
            <time datetime={link.data.date.toISOString()}>{formatDate(link.data.date)}</time>
          </div>
          {link.data.note && (
            <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
              {link.data.note}
            </p>
          )}
          {link.data.tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-2">
              {link.data.tags.map((tag: string) => (
                <span class="inline-block rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </li>
      ))
    }
  </ul>
</BaseLayout>
