---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
---

<BaseLayout title="Projects — alexajuno" description="things i've worked on">
  <section class="pb-8 pt-8 sm:pb-10 sm:pt-12">
    <h1 class="animate-fade-in-up text-4xl font-bold tracking-tight sm:text-5xl">Projects</h1>
    <p class="animate-fade-in-up delay-100 mt-4 max-w-lg text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
      things i've worked on
    </p>
  </section>

  <ul class="space-y-4">
    {
      projects.map((project) => (
        <li class="animate-fade-in-up">
          <a
            href={project.data.link}
            target="_blank"
            rel="noopener noreferrer"
            class="text-lg font-medium text-zinc-900 underline-offset-4 transition-colors hover:text-accent-600 hover:underline dark:text-zinc-100 dark:hover:text-accent-400"
          >
            {project.data.name}
          </a>
          <p class="mt-0.5 text-sm text-zinc-600 dark:text-zinc-400">{project.data.desc}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
