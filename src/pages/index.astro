---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const recentPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

const projects = await getCollection("projects");

const iconLink =
  "text-zinc-500 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100";

const column =
  "border-t border-zinc-200 pt-12 dark:border-zinc-800 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-10";

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout
  wide
  title="alexajuno"
  description="Giao's personal site — building things and writing about the process."
>
  <div
    class="grid grid-cols-1 gap-y-12 pt-8 sm:pt-12 lg:grid-cols-3 lg:gap-x-10 lg:gap-y-0"
  >
    <!-- About -->
    <section>
      <h1 class="animate-fade-in-up text-xl font-semibold tracking-tight">
        About
      </h1>
      <p
        class="animate-fade-in-up delay-100 mt-6 max-w-lg leading-relaxed text-zinc-600 dark:text-zinc-400"
      >
        hi, i'm a software developer. i spend most of the time with the computer
        and let the curiosity lead.
      </p>
      <div class="animate-fade-in-up delay-200 mt-6 flex items-center gap-4">
        <a
          href="https://github.com/alexajuno"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class={iconLink}
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"
            ></path>
          </svg>
        </a>

        <a
          href="https://x.com/giolynx104"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="X"
          class={iconLink}
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117l11.966 15.644Z"
            ></path>
          </svg>
        </a>

        <a
          href="mailto:giolynx104@gmail.com"
          aria-label="Email"
          class={iconLink}
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z"
            ></path>
            <path
              d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z"
            ></path>
          </svg>
        </a>
      </div>
    </section>

    <!-- Projects -->
    <section class={`animate-fade-in-up ${column}`}>
      <h2 class="text-xl font-semibold tracking-tight">Projects</h2>
      <ul class="mt-6 space-y-4">
        {
          projects.map((project) => (
            <li class="animate-fade-in-up">
              <a
                href={project.data.link}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-zinc-900 underline-offset-4 transition-colors hover:text-accent-600 hover:underline dark:text-zinc-100 dark:hover:text-accent-400"
              >
                {project.data.name}
              </a>
              <p class="mt-0.5 text-sm text-zinc-600 dark:text-zinc-400">
                {project.data.desc}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Writing -->
    <section class={`animate-fade-in-up ${column}`}>
      <h2 class="text-xl font-semibold tracking-tight">Writing</h2>
      <ul class="mt-6 space-y-6">
        {
          recentPosts.map((post) => (
            <li class="animate-fade-in-up">
              <a href={`/blog/${post.id}`} class="group block">
                <span class="font-medium text-zinc-900 transition-colors group-hover:text-accent-600 dark:text-zinc-100 dark:group-hover:text-accent-400">
                  {post.data.title}
                </span>
                <time
                  datetime={post.data.date.toISOString()}
                  class="mt-1 block text-sm text-zinc-500 dark:text-zinc-500"
                >
                  {formatDate(post.data.date)}
                </time>
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="/blog"
        class="mt-8 inline-flex items-center gap-1 text-sm font-medium text-accent-600 transition-colors hover:text-accent-500 dark:text-accent-400 dark:hover:text-accent-300"
      >
        All posts
        <svg
          class="h-4 w-4"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
        </svg>
      </a>
    </section>
  </div>
</BaseLayout>
